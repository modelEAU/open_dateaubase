DB_HOST=db
DB_PORT=1433
DB_NAME=open_dateaubase
DB_USER=SA
DB_PASSWORD=CHANGE_ME_use_a_strong_password
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Log viewer (OpenObserve, optional) ---
# Only used with the docker-compose.logs.yml override. Defaults are applied if
# unset (admin@open_dateaubase.local / Complexpass#123). OpenObserve requires a
# reasonably strong password; the Vector shipper reuses these as basic-auth.
# LOGVIEWER_USER=admin@open_dateaubase.local
# LOGVIEWER_PASSWORD=Complexpass#123

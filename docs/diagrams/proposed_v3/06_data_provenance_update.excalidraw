      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "text": "DataProvenance=Forecast distinguishes predicted channels from other model outputs.\nQuerying 'what did the model predict at issue-time T for valid-time T+H?' requires a ForecastRun table\nwith IssuedAt + HorizonStart/HorizonEnd. This is deferred to a follow-up PRD.\nFor now: use ProcessingLineage (ProcessingStep.ExecutedDateTime = issue time) as an approximation.",
      "fontFamily": 3,
      "fontSize": 11,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "lineHeight": 1.5
    }

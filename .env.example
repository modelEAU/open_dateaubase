# ===================================================================
# open_datEAUbase — Environment Variables Example
# Copy to .env.local (local dev) or .env.docker (Docker Compose)
# ===================================================================

# --- Database (required by API) ---
# Host where MSSQL is running.
# Local dev: localhost | Docker Compose: db (the service name)
DB_HOST=localhost

# MSSQL port (default 1433; local dev uses 14330 to avoid conflicts)
DB_PORT=14330

# Database name (created by init.sql)
DB_NAME=open_dateaubase

# SA credentials — change for any non-local environment
DB_USER=SA
DB_PASSWORD=CHANGE_ME_use_a_strong_password

# ODBC driver name (must match what is installed in the container/OS)
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- API Server ---
# Where the Streamlit app reaches the FastAPI server.
# Local dev: http://localhost:8000/api/v1
# Docker Compose: http://api:8000/api/v1 (set automatically in compose)
API_BASE_URL=http://localhost:8000/api/v1

# --- Streamlit App (optional) ---
APP_TITLE=open_datEAUbase
APP_VERSION=1.0.0

# --- Log viewer (OpenObserve, optional) ---
# Credentials for the /logs/ log-inspection UI. If left unset, the Windows
# deploy defaults the user to admin@open_dateaubase.local and generates a strong
# password (written to <LogDir>\logviewer\credentials.txt). Set both to pin them.
# The same values are used as the Vector shipper's basic-auth, so they must match.
# LOGVIEWER_USER=admin@open_dateaubase.local
# LOGVIEWER_PASSWORD=CHANGE_ME_use_a_strong_password
